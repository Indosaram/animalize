{
  "manifest_version": 3,
  "name": "Animalize - 타자 목소리",
  "short_name": "Animalize",
  "description": "웹페이지에서 타자를 치면 치이카와 느낌, 동물 친구 목소리가 나와요.",
  "version": "0.2.0",
  "icons": {
    "48": "assets/images/icon48.png",
    "128": "assets/images/icon128.png"
  },
  "action": {
    "default_title": "Animalize 목소리 고르기",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "assets/images/icon48.png",
      "128": "assets/images/icon128.png"
    }
  },
  "permissions": ["storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "banks/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
