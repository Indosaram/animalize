{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Animalize",
  "version": "0.1.0",
  "identifier": "com.animalize.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:11420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Animalize - 타자 목소리",
        "width": 960,
        "height": 720,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "exceptionDomain": ""
    }
  }
}
